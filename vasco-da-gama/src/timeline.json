    "segments": [
     {
      "caption": "Portugal sat at the far western edge of Europe, locked out of all of it.",
      "s": 0.0,
      "e": 4.742
     },
     {
      "caption": "But it faced the open Atlantic.",
      "s": 5.142,
      "e": 7.572
     },
     {
      "caption": "Encouraged by Prince Henry, Portuguese sailors crept down the coast of Africa, year after year.",
      "s": 8.072,
      "e": 14.561
     },
     {
      "caption": "Cape Bojador in 1434.",
      "s": 14.961,
      "e": 17.998
     },
     {
      "caption": "The Congo River in 1482.",
      "s": 18.298,
      "e": 21.33
     },
     {
      "caption": "Then, in 1488, Bartolomeu Dias rounded the southern tip of Africa.",

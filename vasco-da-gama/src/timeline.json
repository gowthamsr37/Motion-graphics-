    "segments": [
     {
      "caption": "On 20 May 1498, three battered ships dropped anchor off the coast of Kerala, near Calicut.",
      "s": 0.0,
      "e": 7.495
     },
     {
      "caption": "They had sailed from Portugal, all the way around Africa.",
      "s": 8.045,
      "e": 11.69
     },
     {
      "caption": "No European had ever reached India by sea.",
      "s": 12.14,
      "e": 15.598
     },
     {
      "caption": "So why did a small kingdom risk everything to get here?",
      "s": 16.198,
      "e": 19.93
     },
     {
      "caption": "The answer starts with a tiny black seed.",
      "s": 20.43,
      "e": 23.339
     }
    ]
   }

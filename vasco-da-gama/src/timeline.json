    "segments": [
     {
      "caption": "But Europeans never bought them at the source.",
      "s": 0.0,
      "e": 2.975
     },
     {
      "caption": "Spices crossed the Arabian Sea in the ships of Arab and Gujarati merchants,",
      "s": 3.425,
      "e": 8.777
     },
     {
      "caption": "sailed up the Red Sea to Egypt, through Cairo to Alexandria,",
      "s": 9.027,
      "e": 13.21
     },
     {
      "caption": "and there, Venetian traders carried them on into Europe.",
      "s": 13.46,
      "e": 17.187
     },
     {
      "caption": "Every hand along the way took its cut.",
      "s": 17.687,
      "e": 20.525
     },
     {
      "caption": "By the time pepper reached a European table, its price had multiplied many times over.",
      "s": 20.825,
      "e": 27.218
     },
     {
      "caption": "Egypt and Venice held the keys to that trade.",
      "s": 27.718,
      "e": 30.998
     },
     {
      "caption": "And after 1453, the rising Ottoman Empire loomed over the eastern routes too.",
      "s": 31.298,
      "e": 37.337
     }
    ]

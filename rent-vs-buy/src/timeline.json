    "segments": [
     {
      "caption": "Arjun and Meera are both 28. Same job, same salary, same city: Bangalore.",
      "s": 0.0,
      "e": 5.497
     },
     {
      "caption": "And both their parents give them the same gift: \u20b925 lakh.",
      "s": 5.897,
      "e": 9.998
     },
     {
      "caption": "One buys a flat. One rents.",
      "s": 10.399,
      "e": 12.359
     },
     {
      "caption": "Twenty years later, the gap is more than \u20b91 crore.",

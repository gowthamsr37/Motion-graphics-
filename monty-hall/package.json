{
  "name": "monty-hall",
  "version": "1.0.0",
  "private": true,
  "description": "monty-hall: Data Science Made Simple Reel",
  "scripts": {
    "voice": "python scripts/gen-voice.py",
    "audio": "node scripts/gen-audio.mjs",
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts MontyHall out/raw.mp4 --codec h264 --crf 16",
    "build": "bash scripts/build.sh"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.543",
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.543",
    "typescript": "^7.0.2"
  }
}
